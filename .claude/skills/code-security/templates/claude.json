{
  "name": "code-security",
  "version": "3.0.0",
  "description": "Applies OWASP Web/API/LLM Top 10, ASVS 5.0.0, CWE Top 25 2025, and security assurance controls when writing or reviewing code.",
  "author": "your-org",
  "license": "MIT",
  "activation": {
    "auto": true,
    "triggers": [
      "login", "signup", "register", "auth", "authentication",
      "password", "session", "jwt", "token",
      "database", "sql", "query", "db",
      "api", "endpoint", "route", "controller", "graphql", "rest",
      "upload", "file", "image",
      "payment", "stripe", "billing",
      "admin", "dashboard", "cms",
      "security", "secure", "vulnerability", "CVE", "OWASP",
      "encrypt", "hash", "crypto",
      "webhook", "oauth", "oauth2", "openid", "sso",
      "llm", "ai", "openai", "anthropic", "gpt", "claude", "chatbot", "agent", "prompt", "rag",
      "dependency", "package", "npm", "pip", "supply chain", "lockfile",
      "docker", "kubernetes", "k8s", "cloud", "aws", "terraform",
      "microservice", "grpc", "service mesh",
      "threat model", "sdlc", "sast", "dast", "sbom", "secret scanning",
      "websocket", "realtime", "serverless", "lambda",
      "mobile", "android", "ios", "memory", "buffer", "unsafe",
      "privacy", "pii", "retention", "incident response", "runbook"
    ]
  },
  "commands": {
    "scan": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode all",
    "checklist": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode checklist",
    "vuln": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode vuln",
    "crypto": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode crypto",
    "rules": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode rules --lang {language}",
    "asvs": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode asvs",
    "cwe": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode cwe",
    "control": "python3 .claude/skills/code-security/scripts/search.py \"{query}\" --mode control"
  },
  "skill_content_path": "skill-content.md"
}
